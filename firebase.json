{
  "firestore": {
    "rules": "database/firestore.rules",
    "indexes": "database/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "database/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
      "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "database/functions/**",
      "tools/**",
      "logs/**"
    ]
  }
}
